+
+PAGE_W, PAGE_H = A4
+ML, MR, MT, MB = 18 * mm, 18 * mm, 22 * mm, 18 * mm
+CW = PAGE_W - ML - MR  # content width
+
+# ---- styles ---------------------------------------------------------------
+def ps(name, **kw):
+    base = dict(fontName='Plex', bulletFontName='Plex', fontSize=9.4, leading=13.6, textColor=INK, alignment=TA_LEFT)
+    base.update(kw)
+    return ParagraphStyle(name, **base)
+
